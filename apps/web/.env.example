# Supabase (optional). Leave empty to run in local mode (data stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL, used for auth redirects (e.g. https://taxgabay.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Reminders (server only; optional) ---
# Service role key, used only by the /api/cron/reminders job. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Email via Resend (https://resend.com). Leave empty to skip email.
RESEND_API_KEY=
REMINDER_FROM_EMAIL="TaxGabay <reminders@example.com>"
# Web push (generate with: npx web-push generate-vapid-keys). Leave empty to skip push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- AI assistant (server only; optional) ---
ANTHROPIC_API_KEY=
# Use content not yet verified by the CPA (preview deployments only); answers are labelled unverified.
ASSISTANT_ALLOW_UNVERIFIED=
